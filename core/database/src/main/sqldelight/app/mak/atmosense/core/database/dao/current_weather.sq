import kotlin.time.Instant;

CREATE TABLE currentWeatherEntity (
  city_id INTEGER PRIMARY KEY NOT NULL,
  temperature REAL NOT NULL,
  feels_like REAL NOT NULL,
  humidity INTEGER NOT NULL,
  pressure INTEGER NOT NULL,
  wind_speed REAL NOT NULL,
  wind_degrees INTEGER NOT NULL,
  condition_id INTEGER NOT NULL,
  condition_main TEXT NOT NULL,
  condition_description TEXT NOT NULL,
  condition_icon_code TEXT NOT NULL,
  fetched_at INTEGER AS Instant NOT NULL,
  FOREIGN KEY (city_id) REFERENCES cityEntity(id) ON DELETE CASCADE
);

insert:
INSERT OR REPLACE INTO currentWeatherEntity (
  city_id,
  temperature,
  feels_like,
  humidity,
  pressure,
  wind_speed,
  wind_degrees,
  condition_id,
  condition_main,
  condition_description,
  condition_icon_code,
  fetched_at
) VALUES ?;

getByCityId:
SELECT * FROM currentWeatherEntity WHERE city_id = :cityId;

deleteByCityId:
DELETE FROM currentWeatherEntity WHERE city_id = :cityId;

deleteAll:
DELETE FROM currentWeatherEntity;
